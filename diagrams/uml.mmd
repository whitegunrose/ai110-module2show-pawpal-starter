classDiagram
    %% PawPal+ initial design — Owner, Pet, Event, Scheduler

    class Owner {
        +List~Pet~ pets
        +addPet(pet Pet) void
        +addEvent(pet Pet, event Event) void
        +editEvent(pet Pet, event Event) void
        +deleteEvent(pet Pet, event Event) void
    }

    class Pet {
        +Owner owner
        +List~Event~ events
        +List~Event~ schedule
    }

    class Event {
        +int id
        +DateTime time
        +Duration duration
        +Priority priority
        +end() DateTime
        +overlaps(other Event) bool
    }

    class ScheduleResult {
        +List~Event~ scheduled
        +List~Event~ conflicts
    }

    class Scheduler {
        +schedule(pet Pet) ScheduleResult
    }

    Owner "1" --> "*" Pet : owns
    Pet "*" --> "1" Owner : belongs to
    Pet "1" --> "*" Event : has
    Scheduler ..> Pet : reads events / writes schedule
    Scheduler ..> ScheduleResult : returns
